#!/bin/sh
# feature -> stage -> tests pass -> main.
# - main is never pushed: CI fast-forwards it once stage passes the tests.
# - stage takes only commits that come in as merges of feature branches (scripts/flow.sh ship).
# - other branches must be feature/*.
zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue   # deleting a branch
    branch=${remote_ref#refs/heads/}
    case "$branch" in
    main)
        echo "refused: main is not pushed to; CI moves it to stage once the tests pass." >&2
        exit 1 ;;
    stage)
        # Every new first-parent commit on stage must be a merge.
        if [ "$remote_sha" = "$zero" ]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi
        for c in $(git rev-list --first-parent "$range"); do
            if [ "$(git rev-list --parents -n 1 "$c" | wc -w)" -lt 3 ]; then
                echo "refused: $(git log -1 --format='%h %s' "$c") is a direct commit on stage." >&2
                echo "Changes reach stage as merges of feature branches: scripts/flow.sh ship" >&2
                exit 1
            fi
        done ;;
    feature/*) ;;
    refs/tags/v*)
        echo "refused: release tags are made by CI when a version bump reaches main: scripts/flow.sh release <version>" >&2
        exit 1 ;;
    *)
        echo "refused: '$branch' is not a feature/* branch. Start one from stage: scripts/flow.sh new <name>" >&2
        exit 1 ;;
    esac
done
